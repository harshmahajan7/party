<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="create" noun="Person" type="script"
             location="component://party/service/party/createPerson.groovy" authenticate="false">
        <in-parameters>
            <parameter name="partyId" required="true"/>
            <parameter name="firstName" required="true"/>
            <parameter name="lastName" required="true"/>
            <auto-parameters include="all"/>
        </in-parameters>
        <out-parameters>
            <parameter name="responseMessage"/>
        </out-parameters>
    </service>

    <service verb="update" noun="Person" type="entity-auto">
        <in-parameters><auto-parameters entity-name="Person" include="all"/></in-parameters>
    </service>

    <service verb="delete" noun="Person" type="entity-auto">
        <in-parameters><auto-parameters entity-name="Person" include="pk"/></in-parameters>
    </service>

    <service verb="get" noun="Person">
        <in-parameters><parameter name="partyId" required="true"/></in-parameters>
        <out-parameters><auto-parameters entity-name="Person" include="all"/></out-parameters>
        <actions>
            <entity-find-one entity-name="Person" value-field="person"/>
            <script>context.putAll(person)</script>
        </actions>
    </service>

    <service verb="get" noun="Persons">
        <out-parameters><parameter name="personList" type="List"/></out-parameters>
        <actions>
            <entity-find entity-name="Person" list="personList"/>
        </actions>
    </service>

</services>

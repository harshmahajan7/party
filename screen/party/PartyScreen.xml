    <widgets>

        <label type="h2" text="All Parties"/>

        <form-list name="PartyList" list="partyList" header-dialog="true">

            <auto-fields-entity entity-name="party.Party" field-type="find-display"/>

        </form-list>

    </widgets>

</screen>